{
  "compilerOptions": {
    "baseUrl": ".",
	"paths": {
		"utils": ["src/utils.ts"]
	},
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "strictNullChecks": true,
	"strict": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7"
    ]
  },
  "include": [
	"src/**/*.ts",
	"types/**/*.d.ts"
	],
	"exclude": [
		"tests/**",
		"node_modules/**",
		"production/**"
  ]
}
