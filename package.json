{
	"name": "obsidian-epochgram",
	"version": "1.3.14",
	"description": "An AI-powered timeline plugin for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"build:production": "npm run lint && npm run build && node scripts/prepare-production.js --deploy-vault --require-vault",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"sync:pro-keys": "node scripts/sync-pro-keys-from-web.mjs",
		"package:production": "npm run build && node scripts/prepare-production.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@eslint/json": "^0.14.0",
		"@types/diff": "^5.0.8",
		"@types/node": "^20.19.25",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"esbuild-plugin-inline-worker": "^0.1.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"obsidian": "^1.8.7",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.1",
		"vite": "^5.4.21",
		"vitest": "^2.1.9"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.1.0",
		"chrono-node": "^2.9.0",
		"diff": "^5.2.0",
		"minisearch": "^7.2.0",
		"onnxruntime-web": "1.24.3",
		"rrule": "^2.8.1"
	},
	"overrides": {
		"onnxruntime-web": "1.24.3"
	}
}
